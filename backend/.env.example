# Copy to .env and adjust. Never commit .env.
# Every variable here is validated at startup — the process exits with a
# clear message if one is missing or malformed. See src/core/config/.

# --- Runtime ------------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
PORT=3001

# --- HTTP ---------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# Must be explicit in staging and production — no wildcards.
CORS_ORIGINS=http://localhost:3000

# --- Logging ------------------------------------------------------------
# error | warn | log | debug | verbose
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Not yet wired: the database and ORM decision is still open (see AGENTS.md,
# "Open Decisions"). Uncomment and add to the validation schema when it lands.
# DATABASE_URL=postgresql://avunta:password@localhost:5432/avunta
