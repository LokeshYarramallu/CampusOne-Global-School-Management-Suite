# Copy to .env and adjust. Never commit .env.
# Every variable here is validated at startup — the process exits with a
# clear message if one is missing or malformed. See src/core/config/.

# --- Runtime ------------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
PORT=3001

# --- HTTP ---------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# Must be explicit in staging and production — no wildcards.
CORS_ORIGINS=http://localhost:3000

# --- Database -----------------------------------------------------------
# PostgreSQL connection string used by Prisma migrations and the API.
#
# IMPORTANT: the API must connect as a role with NEITHER `SUPERUSER` NOR
# `BYPASSRLS`. Both silently disable the row-level security backstop that
# guards tenant isolation (ADR 0003, ADR 0005) — policies are simply not
# evaluated for such a role. Migrations may still run as the owner.
#
# The API logs a prominent warning at boot when the connected role can bypass
# RLS, so an inert backstop is visible rather than assumed.
#
#   CREATE ROLE campusone_api LOGIN PASSWORD '...' NOSUPERUSER NOBYPASSRLS;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO campusone_api;
DATABASE_URL=postgresql://campusone:password@localhost:5432/campusone?schema=public

# --- Authentication -----------------------------------------------------
# local-dev enables the sample Platform Super Admin account below.
# Production must use the planned Keycloak adapter instead.
AUTH_MODE=local-dev
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
DEV_PLATFORM_ADMIN_EMAIL=platform-admin@campusone.local
# Password for the sample account: CampusOneAdmin!2026
DEV_PLATFORM_ADMIN_PASSWORD_HASH=$2b$12$Z7wzlqSHxF8PM1WsOjfyG.qjsKY3fiBCvhtH.4htCjaTKuqZffZV6

# --- Brute-force protection ---------------------------------------------
# Two independent layers guard the sign-in endpoint.
#
# 1. Per-IP throttle: caps how fast one source can try many accounts.
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
#
# 2. Per-account lockout: caps how many times one account can be tried,
#    however many sources are involved.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Logging ------------------------------------------------------------
# error | warn | log | debug | verbose
LOG_LEVEL=debug
