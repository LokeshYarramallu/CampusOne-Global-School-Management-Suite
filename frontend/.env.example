# Copy to .env.local and adjust. Never commit .env.local.
#
# WARNING: every NEXT_PUBLIC_* variable is compiled into the browser bundle
# and is publicly readable. Never put a secret behind this prefix.

# Base URL of the CampusOne API, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Milliseconds before an API request is aborted.
NEXT_PUBLIC_API_TIMEOUT_MS=15000

# Deployment environment: development | staging | production
NEXT_PUBLIC_APP_ENV=development

# Optional. Email address of the local sample account, shown as a sign-in hint
# and offered as one-click fill on the login page. Ignored when
# NEXT_PUBLIC_APP_ENV=production. Leave unset to hide the hint entirely.
#
# Only the address goes in the bundle. The password is NOT a NEXT_PUBLIC value
# and never reaches the browser — find it in backend/.env.example.
NEXT_PUBLIC_DEV_ADMIN_EMAIL=platform-admin@campusone.local
