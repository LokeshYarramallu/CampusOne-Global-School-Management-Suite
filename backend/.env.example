# Copy to .env and adjust. Never commit .env.
# Every variable here is validated at startup — the process exits with a
# clear message if one is missing or malformed. See src/core/config/.

# --- Runtime ------------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
PORT=3001

# --- HTTP ---------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
# Must be explicit in staging and production — no wildcards.
CORS_ORIGINS=http://localhost:3000

# --- Database -----------------------------------------------------------
# PostgreSQL connection string used by Prisma migrations and the API.
DATABASE_URL=postgresql://campusone:password@localhost:5432/campusone?schema=public

# --- Authentication -----------------------------------------------------
# local-dev enables the sample Platform Super Admin account below.
# Production must use the planned Keycloak adapter instead.
AUTH_MODE=local-dev
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=3600
DEV_PLATFORM_ADMIN_EMAIL=platform-admin@campusone.local
# Password for the sample account: CampusOneAdmin!2026
DEV_PLATFORM_ADMIN_PASSWORD_HASH=$2b$12$Z7wzlqSHxF8PM1WsOjfyG.qjsKY3fiBCvhtH.4htCjaTKuqZffZV6

# --- Logging ------------------------------------------------------------
# error | warn | log | debug | verbose
LOG_LEVEL=debug
