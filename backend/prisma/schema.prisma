generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                  String                 @id @default(uuid()) @db.Uuid
  slug                String                 @unique
  displayName         String                 @map("display_name")
  status              TenantStatus           @default(ACTIVE)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  configuration       TenantConfiguration?
  roles               Role[]
  roleAssignments     RoleAssignment[]
  featureFlags        FeatureFlag[]
  parentSchoolLinks   ParentSchoolLink[]
  auditRecords        AuditRecord[]
  staffProfiles       StaffProfile[]
  enrollments         StudentEnrollment[]
  teachingAssignments TeachingAssignment[]
  changeRequests      ProfileChangeRequest[]
  calendarEvents      CalendarEvent[]

  @@map("tenant")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

model TenantConfiguration {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @unique @map("tenant_id") @db.Uuid
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  timezone           String
  currency           String
  languages          String[]
  moduleActivation   Json     @map("module_activation")
  passwordPolicy     Json     @map("password_policy")
  mfaPolicy          Json     @map("mfa_policy")
  notificationPolicy Json     @map("notification_policy")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@map("tenant_configuration")
}

model UserIdentity {
  id               String                 @id @default(uuid()) @db.Uuid
  keycloakSubject  String?                @unique @map("keycloak_subject")
  email            String                 @unique
  phone            String?
  passwordHash     String?                @map("password_hash")
  status           UserIdentityStatus     @default(ACTIVE)
  failedLoginCount Int                    @default(0) @map("failed_login_count")
  lockedUntil      DateTime?              @map("locked_until")
  lastLoginAt      DateTime?              @map("last_login_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  roleAssignments  RoleAssignment[]
  parentIdentity   ParentIdentity?
  providerLinks    IdentityProviderLink[]
  sessions         AuthSession[]
  passwordResets   PasswordResetToken[]
  mfaFactors       MfaFactor[]
  securityEvents   SecurityEvent[]
  profile          UserProfile?
  preference       UserPreference?
  staffProfiles    StaffProfile[]
  enrollments      StudentEnrollment[]
  changeRequests   ProfileChangeRequest[]
  calendarEvents   CalendarEvent[]

  @@map("user_identity")
}

/// Identity-level. Belongs to the person, not to any school — a parent with
/// children at three schools is one person with one name (PRD §5.3).
/// Deliberately carries no tenant_id.
model UserProfile {
  id              String       @id @default(uuid()) @db.Uuid
  userIdentityId  String       @unique @map("user_identity_id") @db.Uuid
  user            UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Cascade)
  givenName       String       @map("given_name")
  familyName      String       @map("family_name")
  displayName     String?      @map("display_name")
  /// The person's own postal address. Identity-level: it follows them, and a
  /// parent at three schools has one address, not three.
  addressLine     String?      @map("address_line")
  addressCity     String?      @map("address_city")
  addressPostcode String?      @map("address_postcode")
  /// Reserved. Always null until file storage exists (research R2); present so
  /// photo upload needs no migration.
  photoReference  String?      @map("photo_reference")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("user_profile")
}

/// Identity-level. Applies wherever the person uses the platform.
model UserPreference {
  id                      String       @id @default(uuid()) @db.Uuid
  userIdentityId          String       @unique @map("user_identity_id") @db.Uuid
  user                    UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Cascade)
  language                String       @default("en")
  appearance              String       @default("system")
  /// Per-category and per-school; grows with every module that emits
  /// notifications (PRD §5.9), so modelling it relationally now is guesswork.
  notificationPreferences Json         @default("{}") @map("notification_preferences")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  @@map("user_preference")
}

/// Tenant-owned. A person's employment at one school.
model StaffProfile {
  id                  String               @id @default(uuid()) @db.Uuid
  tenantId            String               @map("tenant_id") @db.Uuid
  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  userIdentityId      String               @map("user_identity_id") @db.Uuid
  user                UserIdentity         @relation(fields: [userIdentityId], references: [id])
  employeeNumber      String               @map("employee_number")
  designation         String
  department          String?
  joinedOn            DateTime             @map("joined_on") @db.Date
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  teachingAssignments TeachingAssignment[]

  @@unique([tenantId, userIdentityId])
  @@unique([tenantId, employeeNumber])
  @@index([tenantId, userIdentityId])
  @@map("staff_profile")
}

/// Tenant-owned. The first sliver of the SIS learner record.
///
/// NAMED FOR WHAT IT BECOMES: the student-information feature must EXTEND this
/// table, never create a parallel `student`. Two sources of truth for one
/// learner is the failure this naming prevents.
model StudentEnrollment {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  userIdentityId  String       @map("user_identity_id") @db.Uuid
  user            UserIdentity @relation(fields: [userIdentityId], references: [id])
  admissionNumber String       @map("admission_number")
  classLabel      String       @map("class_label")
  sectionLabel    String       @map("section_label")
  rollNumber      String?      @map("roll_number")
  admittedOn      DateTime     @map("admitted_on") @db.Date
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@unique([tenantId, admissionNumber])
  @@unique([tenantId, userIdentityId])
  @@index([tenantId, userIdentityId])
  @@index([tenantId, classLabel, sectionLabel])
  @@map("student_enrollment")
}

/// Tenant-owned. What a teacher is responsible for.
/// This is the SCOPE that constrains the Teacher role across the platform,
/// not merely a display field.
model TeachingAssignment {
  id             String       @id @default(uuid()) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  staffProfileId String       @map("staff_profile_id") @db.Uuid
  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  subjectLabel   String       @map("subject_label")
  classLabel     String       @map("class_label")
  sectionLabel   String       @map("section_label")
  isClassTeacher Boolean      @default(false) @map("is_class_teacher")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([tenantId, staffProfileId, subjectLabel, classLabel, sectionLabel])
  @@index([tenantId, staffProfileId])
  @@index([tenantId, classLabel, sectionLabel])
  @@map("teaching_assignment")
}

/// Tenant-owned. Created but not exercised in this delivery — the approval
/// workflow (PRD §7.2) needs a notification capability that does not exist.
/// Present so the read-only affordance can name a real destination.
model ProfileChangeRequest {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  userIdentityId  String       @map("user_identity_id") @db.Uuid
  user            UserIdentity @relation(fields: [userIdentityId], references: [id])
  fieldPath       String       @map("field_path")
  requestedValue  String       @map("requested_value")
  status          String       @default("PENDING")
  requestedAt     DateTime     @default(now()) @map("requested_at")
  decidedAt       DateTime?    @map("decided_at")
  decidedByUserId String?      @map("decided_by_user_id") @db.Uuid

  @@index([tenantId, status])
  @@index([tenantId, userIdentityId])
  @@map("profile_change_request")
}

/// Tenant-owned. A calendar event, visible by membership, not by rank.
///
/// `scope` is the visibility hierarchy: a SCHOOL event is seen by everyone in
/// the tenant; a CLASS event only by that class's members (enrolled students,
/// assigned teachers) plus the creator; a PERSONAL event only by its creator.
/// A school admin does NOT see a teacher's class event — membership, not
/// oversight (see the calendar module's visibility.ts).
///
/// "Class" is the `(class_label, section_label)` pair, as everywhere else in
/// CampusOne — there is no classroom entity yet.
model CalendarEvent {
  id            String            @id @default(uuid()) @db.Uuid
  tenantId      String            @map("tenant_id") @db.Uuid
  tenant        Tenant            @relation(fields: [tenantId], references: [id])
  scope         CalendarScope
  /// Set only when scope = CLASS.
  classLabel    String?           @map("class_label")
  sectionLabel  String?           @map("section_label")
  /// Creator: the visibility key for PERSONAL, the edit key for every scope.
  ownerUserId   String            @map("owner_user_id") @db.Uuid
  owner         UserIdentity      @relation(fields: [ownerUserId], references: [id])
  createdByRole String            @map("created_by_role")
  type          CalendarEventType @default(NOTICE)
  title         String
  description   String?
  eventDate     DateTime          @map("event_date") @db.Date
  startTime     String?           @map("start_time")
  endTime       String?           @map("end_time")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([tenantId, eventDate])
  @@index([tenantId, scope, classLabel, sectionLabel])
  @@index([tenantId, ownerUserId])
  @@map("calendar_event")
}

enum CalendarScope {
  SCHOOL
  CLASS
  PERSONAL
}

enum CalendarEventType {
  ACADEMIC
  CULTURAL
  EXAM
  HOLIDAY
  MEETING
  NOTICE
}

model AuthSession {
  id             String       @id @default(uuid()) @db.Uuid
  userIdentityId String       @map("user_identity_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime     @map("expires_at")
  lastUsedAt     DateTime?    @map("last_used_at")
  revokedAt      DateTime?    @map("revoked_at")
  replacedById   String?      @map("replaced_by_id") @db.Uuid
  user           UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Cascade)

  @@index([userIdentityId, revokedAt])
  @@index([expiresAt, revokedAt])
  @@map("auth_session")
}

model PasswordResetToken {
  id             String       @id @default(uuid()) @db.Uuid
  userIdentityId String       @map("user_identity_id") @db.Uuid
  tokenHash      String       @unique @map("token_hash")
  createdAt      DateTime     @default(now()) @map("created_at")
  expiresAt      DateTime     @map("expires_at")
  usedAt         DateTime?    @map("used_at")
  user           UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Cascade)

  @@index([userIdentityId, usedAt])
  @@index([expiresAt, usedAt])
  @@map("password_reset_token")
}

model MfaFactor {
  id             String       @id @default(uuid()) @db.Uuid
  userIdentityId String       @map("user_identity_id") @db.Uuid
  factorType     String       @map("factor_type")
  secret         String       @map("secret_encrypted")
  createdAt      DateTime     @default(now()) @map("created_at")
  verifiedAt     DateTime?    @map("verified_at")
  disabledAt     DateTime?    @map("disabled_at")
  user           UserIdentity @relation(fields: [userIdentityId], references: [id], onDelete: Cascade)

  @@index([userIdentityId, disabledAt])
  @@map("mfa_factor")
}

model SecurityEvent {
  id             String        @id @default(uuid()) @db.Uuid
  userIdentityId String?       @map("user_identity_id") @db.Uuid
  eventType      String        @map("event_type")
  ipHash         String?       @map("ip_hash")
  userAgent      String?       @map("user_agent")
  metadata       Json?
  occurredAt     DateTime      @default(now()) @map("occurred_at")
  user           UserIdentity? @relation(fields: [userIdentityId], references: [id], onDelete: SetNull)

  @@index([userIdentityId, occurredAt])
  @@index([eventType, occurredAt])
  @@map("security_event")
}

enum UserIdentityStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model IdentityProviderLink {
  id              String       @id @default(uuid()) @db.Uuid
  userIdentityId  String       @map("user_identity_id") @db.Uuid
  provider        String
  providerSubject String       @map("provider_subject")
  user            UserIdentity @relation(fields: [userIdentityId], references: [id])

  @@unique([provider, providerSubject])
  @@index([userIdentityId])
  @@map("identity_provider_link")
}

model Permission {
  id        String           @id @default(uuid()) @db.Uuid
  module    String
  feature   String
  action    String
  roleLinks RolePermission[]

  @@unique([module, feature, action])
  @@map("permission")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String?          @map("tenant_id") @db.Uuid
  /// Restrict, not SetNull: a tenant-scoped custom role whose tenant_id became
  /// NULL would silently turn into a platform-wide role. Matches every other
  /// tenant relation in this schema.
  tenant      Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  key         String           @unique
  displayName String           @map("display_name")
  isBuiltIn   Boolean          @default(false) @map("is_built_in")
  assignments RoleAssignment[]
  permissions RolePermission[]

  @@index([tenantId])
  @@map("role")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model RoleAssignment {
  id        String       @id @default(uuid()) @db.Uuid
  tenantId  String       @map("tenant_id") @db.Uuid
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  userId    String       @map("user_id") @db.Uuid
  user      UserIdentity @relation(fields: [userId], references: [id])
  roleId    String       @map("role_id") @db.Uuid
  role      Role         @relation(fields: [roleId], references: [id])
  scope     Json
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([tenantId, userId, roleId])
  @@index([tenantId, userId])
  @@index([tenantId, roleId])
  @@map("role_assignment")
}

model ParentIdentity {
  id             String              @id @default(uuid()) @db.Uuid
  userIdentityId String              @unique @map("user_identity_id") @db.Uuid
  user           UserIdentity        @relation(fields: [userIdentityId], references: [id])
  verifiedEmail  String              @map("verified_email")
  verifiedPhone  String?             @map("verified_phone")
  createdAt      DateTime            @default(now()) @map("created_at")
  schoolLinks    ParentSchoolLink[]
  familyAccess   FamilyAccessGrant[]

  @@map("parent_identity")
}

model ParentSchoolLink {
  id               String           @id @default(uuid()) @db.Uuid
  parentIdentityId String           @map("parent_identity_id") @db.Uuid
  parent           ParentIdentity   @relation(fields: [parentIdentityId], references: [id])
  tenantId         String           @map("tenant_id") @db.Uuid
  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  status           ParentLinkStatus @default(PENDING)
  consentAt        DateTime?        @map("consent_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@unique([parentIdentityId, tenantId])
  @@index([tenantId, parentIdentityId])
  @@map("parent_school_link")
}

enum ParentLinkStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model FamilyAccessGrant {
  id               String         @id @default(uuid()) @db.Uuid
  parentIdentityId String         @map("parent_identity_id") @db.Uuid
  parent           ParentIdentity @relation(fields: [parentIdentityId], references: [id])
  userIdentityId   String         @map("user_identity_id") @db.Uuid
  relationship     String
  scope            Json
  revokedAt        DateTime?      @map("revoked_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([parentIdentityId])
  @@index([userIdentityId])
  @@map("family_access_grant")
}

model FeatureFlag {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  feature   String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, feature])
  @@index([tenantId, feature])
  @@map("feature_flag")
}

model AuditRecord {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  actorId       String?  @map("actor_id") @db.Uuid
  action        String
  targetType    String   @map("target_type")
  targetId      String?  @map("target_id") @db.Uuid
  occurredAt    DateTime @default(now()) @map("occurred_at")
  deviceContext Json     @map("device_context")
  before        Json?
  after         Json?
  prevHash      String?  @map("prev_hash")
  hash          String

  @@index([tenantId, occurredAt])
  @@map("audit_record")
}
